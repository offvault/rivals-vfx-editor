{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rivals-vfx-editor",
  "version": "3.5.0",
  "identifier": "com.rivals-vfx-editor.saturn",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "./RVFXE"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "./RVFXE"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "./RVFXE/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rivals VFX Editor v3.5.0",
        "width": 1440,
        "height": 920,
        "dragDropEnabled": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "./build/icon.png",
      "./build/icon.ico"
    ],
    "resources": {
      "./UAssetToolRivals/src/UAssetTool/bin/Release/net8.0/win-x64/publish/UAssetTool.exe": "tools/UAssetTool.exe"
    }
  }
}